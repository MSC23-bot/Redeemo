// ═══════════════════════════════════════════════════════════════════════════
// REDEEMO DATABASE SCHEMA
// Prisma 7 — datasource URL is in prisma.config.ts, not here
// ═══════════════════════════════════════════════════════════════════════════
//
// ENTITY RELATIONSHIPS (summary)
//
// USER
//   ├── UserSsoProvider (1:many)          — Google/Apple/Facebook SSO links
//   ├── Subscription (1:1)                — one active subscription at a time
//   ├── VoucherRedemption (1:many)        — events of redeeming vouchers
//   ├── UserVoucherCycleState (1:many)    — monthly cycle state per voucher
//   ├── FavouriteMerchant (1:many)        — DEPRECATED — kept during Phase 3C.1g transition; removed in cleanup PR
//   ├── FavouriteVoucher (1:many)
//   ├── FavouriteBranch (1:many)          — Phase 3C.1g locked product principle (branch-level favourites)
//   ├── Review (1:many)                   — reviews are on branches
//   ├── Notification (1:many)
//   ├── CommunicationLog (1:many)
//   └── UserInterest (1:many)
//
// MERCHANT
//   ├── MerchantAdmin (1:1)               — web portal login
//   ├── Branch (1:many)
//   │     ├── BranchUser (1:many)         — mobile app (scan/validate) logins
//   │     ├── BranchOpeningHours
//   │     ├── BranchPhoto
//   │     ├── BranchAmenity → Amenity
//   │     ├── VoucherRedemption           — where the redemption happened
//   │     ├── Review                      — reviews are per branch
//   │     └── FavouriteBranch (1:many)    — branch-level favourites (Phase 3C.1g)
//   ├── Voucher (1:many)                  — vouchers belong to merchant,
//   │                                        redeemable at any branch
//   ├── MerchantDocument (1:many)
//   ├── MerchantContract (1:1)
//   ├── MerchantCategory → Category
//   ├── MerchantTag (1:many)
//   ├── CampaignMerchant → Campaign
//   ├── FeaturedMerchant (1:many)
//   └── FavouriteMerchant (1:many)
//
// VOUCHER
//   ├── VoucherRedemption (1:many)
//   ├── UserVoucherCycleState (1:many)    ← KEY TABLE: monthly cycle enforcement
//   └── FavouriteVoucher (1:many)
//
// SUBSCRIPTION
//   ├── SubscriptionPlan (many:1)
//   └── PromoCode (many:1, optional)
//
// ADMIN
//   ├── AdminUser                         — admin panel logins
//   └── AdminApproval (1:many)            — merchant + voucher approval queue
//
// CAMPAIGNS
//   ├── Campaign → CampaignMerchant → Merchant
//   └── FeaturedMerchant → Merchant
//
// ADMIN-MANAGED REFERENCE DATA
//   ├── Category (hierarchical, self-referential)
//   ├── Amenity
//   ├── Interest
//   └── CmsContent (key-value store)
//
// COMMUNICATIONS
//   ├── Notification (in-app + push, per user)
//   └── CommunicationLog (email/SMS/push audit trail)
//
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  CONTENT
  SUPPORT
}

// ─────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────

model User {
  id                       String     @id @default(uuid())
  email                    String     @unique
  phone                    String?    @unique
  phoneCountryCode         String?
  passwordHash             String?
  firstName                String?
  lastName                 String?
  dateOfBirth              DateTime?
  gender                   String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  postcode                 String?
  profileImageUrl          String?
  status                   UserStatus @default(ACTIVE)
  newsletterConsent        Boolean    @default(false)
  tcConsentVersion         String?
  tcConsentAt              DateTime?
  tutorialSeen             Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  deletedAt                DateTime?
  emailVerified            Boolean    @default(false)
  phoneVerified            Boolean    @default(false)
  marketingConsentAt       DateTime?
  stripeCustomerId         String?    @unique // set on first setup-intent call, reused on subsequent calls
  onboardingCompletedAt    DateTime?
  subscriptionPromptSeenAt DateTime?

  // Plan 4a location snapshot — see spec §3.4
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)
  localityId         String?
  postTown           String?
  ladDistrict        String?
  adminCounty        String?
  region             String?
  country            String? // "England" | "Scotland" | "Wales" | "Northern Ireland"
  locationResolvedAt DateTime?

  locality Locality? @relation("UserLocality", fields: [localityId], references: [id])

  ssoProviders               UserSsoProvider[]
  interests                  UserInterest[]
  redemptions                VoucherRedemption[]
  voucherCycleStates         UserVoucherCycleState[]
  subscription               Subscription?
  reviews                    Review[]
  reviewReports              ReviewReport[]
  reviewHelpfuls             ReviewHelpful[]
  favouriteMerchants         FavouriteMerchant[]
  favouriteVouchers          FavouriteVoucher[]
  favouriteBranches          FavouriteBranch[]
  notifications              Notification[]
  communications             CommunicationLog[]
  redemptionScreenshotEvents RedemptionScreenshotEvent[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([localityId])
}

model UserSsoProvider {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerUid String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUid])
  @@index([userId])
}

// ─────────────────────────────────────────
// MERCHANT ADMIN (Web Portal login)
// ─────────────────────────────────────────

model MerchantAdmin {
  id                 String     @id @default(uuid())
  email              String     @unique
  phone              String?
  phoneCountryCode   String?
  passwordHash       String?
  firstName          String
  lastName           String
  jobTitle           String?
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  otpVerifiedAt      DateTime?
  mustChangePassword Boolean    @default(false)
  // M1 Slice R: gate merchant login on a verified email. Self-registered owners
  // start false (flip true on email-verify); claimed/seeded owners backfilled true.
  emailVerified      Boolean    @default(false)

  // Phase 2 Slice 1 M6b (D-1): MerchantAdmin.merchantId + the `merchant` relation
  // were DROPPED — MerchantMembership is now the sole source of truth linking an
  // admin to a merchant (resolveAdminMerchant / getOwnerMembership).
  memberships MerchantMembership[]

  @@index([email])
}

// ─────────────────────────────────────────
// MERCHANT MEMBERSHIP (Phase 2 Slice 1 M1 — ownership foundation)
// Additive ownership model: a MerchantAdmin person holds one or more
// memberships of a Merchant. Slice 1 creates OWNER memberships only
// (allBranches=true, no join rows). MerchantMembershipBranch is built now
// (D-2/D-7 franchise-ready) but populated only when a BRANCH_MANAGER is
// scoped to branches in a later slice.
// ─────────────────────────────────────────

enum MerchantRole {
  OWNER
  BRANCH_MANAGER
  STAFF
}

model MerchantMembership {
  id              String       @id @default(uuid())
  merchantId      String
  merchantAdminId String
  role            MerchantRole
  allBranches     Boolean      @default(true)
  status          UserStatus   @default(ACTIVE)
  invitedById     String? // forward-compat: who invited this member (no FK yet)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  merchant      Merchant                   @relation(fields: [merchantId], references: [id])
  merchantAdmin MerchantAdmin              @relation(fields: [merchantAdminId], references: [id])
  branches      MerchantMembershipBranch[]

  @@unique([merchantId, merchantAdminId])
  @@index([merchantId])
  @@index([merchantAdminId])
}

model MerchantMembershipBranch {
  id           String   @id @default(uuid())
  membershipId String
  branchId     String
  createdAt    DateTime @default(now())

  membership MerchantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([branchId])
}

// ─────────────────────────────────────────
// BRANCH USER (Merchant Mobile App login)
// ─────────────────────────────────────────

model BranchUser {
  id                 String     @id @default(uuid())
  branchId           String
  email              String     @unique
  phone              String?
  phoneCountryCode   String?
  passwordHash       String
  firstName          String
  lastName           String
  jobTitle           String?
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  mustChangePassword Boolean    @default(false)

  branch      Branch              @relation(fields: [branchId], references: [id])
  validations VoucherRedemption[]

  @@index([email])
  @@index([branchId])
}

// ─────────────────────────────────────────
// SESSION TRACKING
// ─────────────────────────────────────────

model UserSession {
  id            String    @id @default(cuid())
  entityId      String
  entityType    String // 'customer' | 'merchant' | 'branch' | 'admin'
  sessionId     String    @unique
  deviceId      String
  deviceType    String // 'ios' | 'android' | 'web'
  deviceName    String?
  ipAddress     String
  userAgent     String
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  @@index([entityId, entityType])
  @@index([sessionId])
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

// Phase 2 Slice 1 M2 — platform-wide audit actor (additive). actorId/actorType
// record WHO performed the action (distinct from entityId/entityType = the
// TARGET); before/after capture state for state-changing actioner ops; reason
// carries admin-supplied justification. All nullable — existing fire-and-forget
// writeAuditLog rows leave them null.
enum ActorType {
  ADMIN
  MERCHANT_ADMIN
  BRANCH_MANAGER
  BRANCH_STAFF
  CUSTOMER
  SYSTEM
}

model AuditLog {
  id         String     @id @default(cuid())
  entityId   String
  entityType String // 'customer' | 'merchant' | 'branch' | 'admin'
  event      String
  ipAddress  String
  userAgent  String
  deviceId   String?
  sessionId  String?
  metadata   Json?
  actorId    String? // M2 audit-actor: who performed the action
  actorType  ActorType?
  before     Json? // state before (state-changing actioner ops)
  after      Json? // state after
  reason     String? // admin-supplied justification
  createdAt  DateTime   @default(now())

  @@index([entityId, entityType])
  @@index([event])
  @@index([createdAt])
  @@index([actorId])
}

// ─────────────────────────────────────────
// ADMIN USER (Admin Panel login)
// ─────────────────────────────────────────

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvals AdminApproval[]

  @@index([email])
}

// ─────────────────────────────────────────
// ENUMS (merchant)
// ─────────────────────────────────────────

enum MerchantStatus {
  REGISTERED
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum CategoryIntentType {
  LOCAL
  DESTINATION
  MIXED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ContractStatus {
  NOT_SIGNED
  SIGNED
}

enum DocumentType {
  BUSINESS_VERIFICATION_1
  BUSINESS_VERIFICATION_2
  PRICE_LIST
  AGREEMENT
}

enum SignatureMethod {
  CLICK_TO_AGREE
  ZOHO_SIGN
}

// ─────────────────────────────────────────
// MERCHANT
// ─────────────────────────────────────────

model Merchant {
  id                     String             @id @default(uuid())
  businessName           String
  tradingName            String?
  companyNumber          String?
  vatNumber              String?
  status                 MerchantStatus     @default(REGISTERED)
  verificationStatus     VerificationStatus @default(NOT_SUBMITTED)
  contractStatus         ContractStatus     @default(NOT_SIGNED)
  contractStartDate      DateTime?
  contractEndDate        DateTime?
  websiteUrl             String?
  logoUrl                String?
  bannerUrl              String?
  description            String?
  primaryCategoryId      String?
  primaryDescriptorTagId String?
  onboardingStep         OnboardingStep     @default(REGISTERED)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  // SEC-C3: seed/demo data flag. Customer-facing queries exclude isTestData=true
  // rows (PR-4b); prisma/seed.ts marks all seeded rows true. Default false = real.
  isTestData             Boolean            @default(false)

  // M6b (D-1): the `admin MerchantAdmin?` back-relation was dropped with
  // MerchantAdmin.merchantId — admins link via MerchantMembership now.
  memberships          MerchantMembership[]
  branches             Branch[]
  documents            MerchantDocument[]
  contract             MerchantContract?
  suggestedTags        MerchantSuggestedTag[]
  categories           MerchantCategory[]
  vouchers             Voucher[]
  favouritedBy         FavouriteMerchant[]
  campaignMerchants    CampaignMerchant[]
  featuredListings     FeaturedMerchant[]
  primaryCategory      Category?              @relation("MerchantPrimaryCategory", fields: [primaryCategoryId], references: [id])
  primaryDescriptorTag Tag?                   @relation("MerchantPrimaryDescriptorTag", fields: [primaryDescriptorTagId], references: [id])
  tags                 MerchantTag[]
  highlights           MerchantHighlight[]
  pendingEdits         MerchantPendingEdit[]
  branchPendingEdits   BranchPendingEdit[]

  @@index([status])
  @@index([primaryCategoryId])
  @@index([primaryDescriptorTagId])
  @@index([isTestData])
}

// ─────────────────────────────────────────
// MERCHANT PENDING EDIT
// ─────────────────────────────────────────

model MerchantPendingEdit {
  id              String            @id @default(uuid())
  merchantId      String
  proposedChanges Json
  status          PendingEditStatus @default(PENDING)
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
}

// ─────────────────────────────────────────
// BRANCH
// ─────────────────────────────────────────

model Branch {
  id            String   @id @default(uuid())
  merchantId    String
  name          String
  isMainBranch  Boolean  @default(false)
  addressLine1  String
  addressLine2  String?
  city          String
  postcode      String
  // Legacy ADDRESS-country (ISO-3166 alpha-2; defaults "GB"). DISTINCT from
  // the Plan 4 `locationCountry` column below which carries the resolved
  // NATION ("England" / "Scotland" / "Wales" / "Northern Ireland"). Both
  // coexist for one deprecation cycle — `country` for the address envelope
  // and any external integrations expecting an ISO-2 code, `locationCountry`
  // for Plan 4 discovery / locality rollups. M5 cleanup audits whether the
  // legacy field can be retired.
  country       String   @default("GB")
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  phone         String?
  email         String?
  websiteUrl    String?
  logoUrl       String?
  bannerUrl     String?
  about         String?
  priceListUrl  String?
  redemptionPin String? // AES-256-GCM encrypted 4-digit PIN; null until merchant sets it
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // §BRANCHDEL: soft-delete marker. DISTINCT from `isActive` (the merchant's
  // reversible open/closed toggle) — `deletedAt != null` means the branch was
  // permanently removed by the merchant. `softDeleteBranch` sets BOTH
  // deletedAt + isActive=false; all branch-management reads filter `deletedAt:null`;
  // customer discovery already excludes it via `isActive:false`. History
  // (redemptions/reviews) is preserved by FK. Mirrors User/Merchant soft-delete.
  deletedAt     DateTime?
  // SEC-C3: seed/demo data flag (see Merchant.isTestData).
  isTestData    Boolean  @default(false)

  // Plan 4a location snapshot — see spec §3.5.
  // NOTE: `locationCountry` is the resolved NATION (England/Scotland/Wales/NI).
  // It is INTENTIONALLY distinct from the existing `country` column above
  // (which is the ISO-2 address country, default "GB"). Both fields coexist
  // for one deprecation cycle — see the comment on `country` for the
  // semantic split.
  //
  // `postTown` is currently mostly null in M1: the ONSPD seed generator
  // doesn't populate Locality.postTown (the BUA join supplies a name but
  // not a post-town), and postcodes.io's `post_town` field is also not
  // reliably populated for every postcode. M1.16 + M1.22 backfill paths
  // preserve whatever postcodes.io returns (null where absent). Future
  // post-town enrichment (a separate ONS lookup or PAF data feed) will
  // populate this densely.
  localityId         String?
  localityName       String?
  postTown           String?
  ladDistrict        String?
  adminCounty        String?
  region             String?
  locationCountry    String?
  locationResolvedAt DateTime?
  locationConfidence LocationConfidence @default(POSTCODE_CENTROID)

  locality Locality? @relation("BranchLocality", fields: [localityId], references: [id])

  // Opposite relation for Plan 4b Campaign.branchAnchor — see Step 8 below
  anchoredCampaigns Campaign[] @relation("CampaignBranchAnchor")

  merchant           Merchant                   @relation(fields: [merchantId], references: [id])
  openingHours       BranchOpeningHours[]
  photos             BranchPhoto[]
  users              BranchUser[]
  amenities          BranchAmenity[]
  redemptions        VoucherRedemption[]
  reviews            Review[]
  pendingEdits       BranchPendingEdit[]
  favouritedBy       FavouriteBranch[]
  membershipBranches MerchantMembershipBranch[]

  @@index([merchantId])
  @@index([latitude, longitude])
  @@index([isActive])
  @@index([localityId])
  @@index([isTestData])
}

model BranchOpeningHours {
  id        String  @id @default(uuid())
  branchId  String
  dayOfWeek Int
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

// Photo-moderation gate (Phase 0 PR-0.6). A branch photo is publicly visible
// ONLY when APPROVED (scanner CLEAN or admin-approved). New photos default
// PENDING; the discovery read-path filters to APPROVED so an unmoderated or
// flagged photo can never reach a customer surface.
enum PhotoModerationStatus {
  PENDING // awaiting a scan / admin review — NOT public
  APPROVED // scanner CLEAN or admin-approved — the ONLY public state
  FLAGGED // scanner / admin flagged — NOT public
}

model BranchPhoto {
  id        String   @id @default(uuid())
  branchId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // PR-0.6 moderation gate. Default PENDING ⇒ a freshly-uploaded photo is never
  // public until something (scanner or admin) moves it to APPROVED.
  moderationStatus    PhotoModerationStatus @default(PENDING)
  moderationCheckedAt DateTime? // when a scan resolved it (CLEAN/FLAGGED); null ⇒ never scanned
  moderationDetail    String? // optional reason / provider note when FLAGGED

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  // Discovery filters by (branchId, moderationStatus); cap counts per branch.
  @@index([branchId, moderationStatus])
}

// ─────────────────────────────────────────
// BRANCH PENDING EDIT
// ─────────────────────────────────────────

model BranchPendingEdit {
  id              String            @id @default(uuid())
  branchId        String
  merchantId      String
  proposedChanges Json
  includesPhotos  Boolean           @default(false)
  status          PendingEditStatus @default(PENDING)
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  branch   Branch   @relation(fields: [branchId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([branchId, status])
  @@index([merchantId, status])
}

// ─────────────────────────────────────────
// MERCHANT VERIFICATION
// ─────────────────────────────────────────

model MerchantDocument {
  id           String       @id @default(uuid())
  merchantId   String
  documentType DocumentType
  fileUrl      String
  uploadedAt   DateTime     @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model MerchantContract {
  id                String          @id @default(uuid())
  merchantId        String          @unique
  signedAt          DateTime        @default(now())
  ipAddress         String
  tcVersion         String
  signatureMethod   SignatureMethod
  zohoSignRequestId String?

  merchant Merchant @relation(fields: [merchantId], references: [id])
}

// ─────────────────────────────────────────
// MERCHANT-SUGGESTED TAGS
// (free-text tags merchants submit during onboarding,
//  moderated by admin. NOT the curated taxonomy Tag system.)
// ─────────────────────────────────────────

enum MerchantSuggestedTagStatus {
  PENDING
  APPROVED
  REJECTED
}

model MerchantSuggestedTag {
  id         String                     @id @default(uuid())
  merchantId String
  tag        String
  status     MerchantSuggestedTagStatus @default(PENDING)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, tag])
  @@index([tag])
}

// ─────────────────────────────────────────
// CURATED TAG TAXONOMY
// See docs/superpowers/specs/2026-04-28-category-taxonomy-design.md
// ─────────────────────────────────────────

enum TagType {
  CUISINE
  SPECIALTY
  HIGHLIGHT
  DETAIL
}

enum TagCreatedBy {
  SYSTEM
  ADMIN
}

model Tag {
  id                  String       @id @default(uuid())
  label               String
  type                TagType
  descriptorEligible  Boolean      @default(false)
  isActive            Boolean      @default(true)
  createdBy           TagCreatedBy @default(SYSTEM)
  createdAt           DateTime     @default(now())
  merchantCountByCity Json         @default("{}") // { cityId: count }

  subcategoryLinks   SubcategoryTag[]
  merchantLinks      MerchantTag[]
  merchantHighlights MerchantHighlight[]
  redundantFor       RedundantHighlight[]
  primaryFor         Merchant[]           @relation("MerchantPrimaryDescriptorTag")

  @@unique([label, type])
  @@index([type, isActive])
}

model SubcategoryTag {
  id                String  @id @default(uuid())
  subcategoryId     String
  tagId             String
  isPrimaryEligible Boolean @default(false)

  subcategory Category @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, tagId])
  @@index([tagId])
}

model MerchantTag {
  id         String @id @default(uuid())
  merchantId String
  tagId      String

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@unique([merchantId, tagId])
  @@index([tagId])
}

model MerchantHighlight {
  id             String @id @default(uuid())
  merchantId     String
  highlightTagId String
  sortOrder      Int    @default(0)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [highlightTagId], references: [id])

  @@unique([merchantId, highlightTagId])
}

model RedundantHighlight {
  id             String  @id @default(uuid())
  subcategoryId  String
  highlightTagId String
  reason         String?

  subcategory Category @relation("CategoryRedundantHighlights", fields: [subcategoryId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [highlightTagId], references: [id])

  @@unique([subcategoryId, highlightTagId])
  @@index([highlightTagId])
}

// ─────────────────────────────────────────
// CATEGORIES (admin-managed, hierarchical)
// ─────────────────────────────────────────

enum CategoryDescriptorState {
  RECOMMENDED
  OPTIONAL
  HIDDEN
}

model Category {
  id                    String                   @id @default(uuid())
  name                  String
  iconUrl               String?
  illustrationUrl       String?
  parentId              String?
  sortOrder             Int                      @default(0)
  isActive              Boolean                  @default(true)
  pinColour             String? // hex colour for map pin e.g. "#FF5733"
  pinIcon               String? // icon key from agreed icon set e.g. "fork-knife"
  descriptorState       CategoryDescriptorState? // subcategories only
  descriptorSuffix      String? // override; defaults to category name
  intentType            CategoryIntentType?
  merchantCountByCity   Json                     @default("{}") // { cityId: count }
