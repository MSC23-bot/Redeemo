model BranchPendingEdit {
  id              String            @id @default(uuid())
  branchId        String
  merchantId      String
  proposedChanges Json
  includesPhotos  Boolean           @default(false)
  status          PendingEditStatus @default(PENDING)
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  branch   Branch   @relation(fields: [branchId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([branchId, status])
  @@index([merchantId, status])
}

// ─────────────────────────────────────────
// BRANCH OPENING HOURS PENDING (PR-4: 2-hour customer cool-off)
// ─────────────────────────────────────────

// Branches PR-4 (umbrella D4): a self-promoting, durable staging record for an
// opening-hours change. A merchant edit does NOT go live immediately — it writes
// ONE BranchOpeningHoursPending row holding the proposed weekly schedule plus
// `effectiveAt = stage time + 2h`. The live `BranchOpeningHours` (and therefore
// every customer read via isOpenNow) is UNCHANGED until a worker promotes the row
// at effectiveAt. Self-service delayed activation — NO admin review, NO
// AdminApproval, NO ApprovalType value, NO editApplier path.
model BranchOpeningHoursPending {
  id String @id @default(uuid())

  branchId   String
  merchantId String

  // The full proposed weekly schedule as a single-window-per-day JSON payload,
  // shaped EXACTLY like the setOpeningHours OpeningHoursInput
  // (Array<{ dayOfWeek, openTime?, closeTime?, isClosed }>). Validated by
  // validateOpeningHours BEFORE persistence. Single-window only (multi-window = PR-8).
  proposedHours Json
  // = stage time + 2h (the cool-off boundary). Promotion upserts proposedHours into
  // the live BranchOpeningHours once effectiveAt has passed.
  effectiveAt   DateTime
  status        PendingHoursStatus @default(PENDING)
  // The merchant actor's MerchantAdmin id (req.user.sub / ctx.adminId), the SAME id
  // used elsewhere for audit attribution; NOT a MerchantMembership id.
  createdBy     String
  createdAt     DateTime           @default(now())
  promotedAt    DateTime?
  cancelledAt   DateTime?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([status, effectiveAt]) // cheap due-row scan for the promotion sweep
  @@index([branchId, status]) // merchant-web read + the at-most-one-PENDING lookup
  // NOTE: the at-most-one-PENDING-per-branch INVARIANT is DB-ENFORCED by a PARTIAL
  // UNIQUE index added in the migration (raw SQL, since Prisma cannot express a
  // partial unique in the schema):
  //   CREATE UNIQUE INDEX ... ON "BranchOpeningHoursPending"("branchId") WHERE status = 'PENDING';
  // The @@index above is for lookups/reads, NOT the uniqueness guarantee.
}

enum PendingHoursStatus {
  PENDING
  PROMOTED
  CANCELLED
}

// ─────────────────────────────────────────
// MERCHANT VERIFICATION
// ─────────────────────────────────────────

model MerchantDocument {
  id           String       @id @default(uuid())
  merchantId   String
  documentType DocumentType
  fileUrl      String
  uploadedAt   DateTime     @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model MerchantContract {
  id                String          @id @default(uuid())
  merchantId        String          @unique
  signedAt          DateTime        @default(now())
  ipAddress         String
  tcVersion         String
  signatureMethod   SignatureMethod
  zohoSignRequestId String?

  merchant Merchant @relation(fields: [merchantId], references: [id])
}

// D65 (spec §4.1): the IMMUTABLE, APPEND-ONLY agreement evidence ledger. Sits
// BESIDE MerchantContract (which stays the 1:1 "current contract" pointer the
// onboarding gate reads); this is the per-signing-event evidence pack (agreement
// version + content hash, signer identity, witness, when/where, and the signed
// private-R2 PDF). Immutability is an APPLICATION-LEVEL CONTRACT, not a DB feature:
// NO service code ever issues update/delete against this table - a superseding
// agreement version produces a NEW row, leaving prior rows untouched (a guard test
// asserts no update/delete call sites exist). merchantId is a real RESTRICT FK
// (structural parent, like MerchantNote); actorAdminId is a bare admin-id column
// (NO FK, matching the MerchantLead.assignedRepId / AdminApproval.claimedById
// precedent). Leaf table -> the migration stays create-only.
model MerchantAgreementRecord {
  id                     String              @id @default(uuid())
  merchantId             String

  // Agreement identity (WHAT was signed).
  agreementVersion       String
  contentHash            String

  // Signatory identity (WHO signed). signerName is the typed full name = the
  // signature of record; signerRoleConfirmation is the authority attestation.
  signerName             String
  signerRoleConfirmation String

  // Witness / channel. actorAdminId = the witnessing rep on IN_PERSON_ASSISTED;
  // NULL on self-serve. The rep is NEVER the signer (admin-never-signs lock).
  actorAdminId           String?
  method                 AgreementSignMethod

  // When + where.
  signedAt               DateTime            @default(now())
  ipAddress              String
  userAgent              String

  // Signed artifact (private R2 document key) + optional stylus image.
  pdfKey                 String
  drawnSignatureKey      String?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
}

