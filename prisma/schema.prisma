// ─────────────────────────────────────────
// ENUMS (admin operations)
// ─────────────────────────────────────────

enum ApprovalType {
  MERCHANT_ONBOARDING
  VOUCHER
  MERCHANT_PROFILE_EDIT
  MERCHANT_IDENTITY_EDIT
  BRANCH_IDENTITY_EDIT
}

enum NotificationRecipientType {
  USER
  MERCHANT_ADMIN
  BRANCH_USER
  ADMIN
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationType {
  SUBSCRIPTION_REMINDER
  VOUCHER_REDEEMED
  ADMIN_BROADCAST
  MERCHANT_VERIFICATION_UPDATE
  VOUCHER_APPROVAL_UPDATE
  CAMPAIGN_INVITE
  FEATURED_LISTING_UPDATE
  VOUCHER_EXPIRY_ALERT
  // M2: explicit admin in-app notification types (plan §7.2). One per actioner /
  // ops event so the bell can filter, group, and icon each, rather than a single
  // generic admin type.
  ADMIN_MERCHANT_SUBMITTED
  ADMIN_MERCHANT_RESUBMITTED
  ADMIN_CLAIM_STALE
  ADMIN_OWNER_EMAIL_BOUNCED
  ADMIN_DELIVERY_FAILED
  ADMIN_REVIEW_ASSIGNED
}

enum CommunicationChannel {
  EMAIL
  SMS
  PUSH
}

enum CommunicationStatus {
  // QUEUED is the durable-outbox state (Phase 0 PR-0.4): notify() commits a
  // QUEUED row, then enqueues delivery; a worker flips it off QUEUED. A row only
  // stays QUEUED while genuinely undelivered — which is what the reconciler
  // looks for. SENT/FAILED/BOUNCED are terminal.
  QUEUED
  SENT
  FAILED
  BOUNCED
}

// ─────────────────────────────────────────
// ADMIN APPROVALS QUEUE
// ─────────────────────────────────────────

model AdminApproval {
  id            String         @id @default(uuid())
  type          ApprovalType
  referenceId   String
  referenceType String
  status        ApprovalStatus @default(PENDING)
  adminUserId   String? // the admin who ACTIONED it (approve/reject)
  comment       String?
  submittedAt   DateTime       @default(now())
  actionedAt    DateTime?
  // M3 claim-to-review. Bare id (no FK relation) keeps the migration purely
  // additive — a claimedBy FK would force naming the existing adminUser/approvals
  // relation (Prisma 2-relation disambiguation). claimedById is set from the
  // authenticated admin's id; admins are not hard-deleted.
  claimedById   String? // the admin currently reviewing it
  claimedAt     DateTime?
  // WP4: one-shot dedup for the ADMIN_CLAIM_STALE bell alert. Set by the
  // maintenance sweep when it alerts the claimer; re-arms only when a LATER
  // claim (claimedAt > lastStaleAlertAt, after release + reclaim) occurs.
  // Nullable + no default => purely additive; existing rows backfill to NULL
  // (never alerted, eligible on the first sweep).
  lastStaleAlertAt DateTime?

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([type])
  @@index([status])
  @@index([referenceId])
  @@index([claimedById])
  @@index([status, claimedAt]) // WP4: stale-claim sweep scan
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id            String                    @id @default(uuid())
  recipientType NotificationRecipientType
  // M2: canonical recipient pointer, paired with recipientType (USER -> User id,
  // MERCHANT_ADMIN -> MerchantAdmin id, BRANCH_USER -> BranchUser id, ADMIN ->
  // AdminUser id). Polymorphic, so no DB FK; the notify() write-path enforces it
  // is always set. `userId` below is the legacy customer FK relation, kept for
  // USER rows only (== recipientId there). Bell queries by (recipientType,
  // recipientId), never by joining CommunicationLog (delivery vs in-app stay
  // separate).
  recipientId   String
  userId        String?
  title         String
  body          String
  type          NotificationType
  channel       NotificationChannel
  referenceId   String?
  referenceType String?
  isRead        Boolean                   @default(false)
  readAt        DateTime?
  sentAt        DateTime                  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([recipientType])
  @@index([isRead])
  @@index([sentAt])
  // M2 bell-feed: unread count + unread list query by (recipientType,
  // recipientId, isRead); the ordered feed by (recipientType, recipientId,
  // sentAt).
  @@index([recipientType, recipientId, isRead])
  @@index([recipientType, recipientId, sentAt])
}

// ─────────────────────────────────────────
// COMMUNICATION LOG
// ─────────────────────────────────────────

model CommunicationLog {
  id            String               @id @default(uuid())
  recipientType String
  recipientId   String
  channel       CommunicationChannel
  type          String
  subject       String?
  status        CommunicationStatus  @default(QUEUED)
  externalId    String?
  sentAt        DateTime             @default(now())
  userId        String?

  // The rendered message the delivery worker / outbox reconciler sends. It is
  // the ONLY way a reconciler-re-enqueued job (which carries just the row id)
  // can reconstruct the email, so it makes CommunicationLog a true outbox. It
  // can contain delivery-sensitive content (a reset link, a branch PIN), so the
  // worker NULLS it the moment the row reaches a terminal state — the payload
  // exists only during the brief QUEUED delivery window, never long-term.
  payload Json?

  user User? @relation(fields: [userId], references: [id])

  @@index([recipientId])
  @@index([channel])
  @@index([type])
  @@index([sentAt])
  // Outbox reconciler scan: WHERE status = QUEUED AND sentAt < now() − GRACE.
  @@index([status, sentAt])
  // Bounce/complaint webhook resolves the row by the provider's email id.
  @@index([externalId])
}

