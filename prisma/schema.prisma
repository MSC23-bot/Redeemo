// ─────────────────────────────────────────
// ENUMS (voucher)
// ─────────────────────────────────────────

enum VoucherType {
  BOGO
  SPEND_AND_SAVE
  DISCOUNT_FIXED
  DISCOUNT_PERCENT
  FREEBIE
  PACKAGE_DEAL
  TIME_LIMITED
  REUSABLE
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED // M3: admin requested changes; the merchant edits + resubmits (reopens the same approval)
  // Voucher governed flows (D3, 2026-07-07): the merchant withdrew their own
  // not-yet-actioned submission/request (self-service, no admin). Terminal:
  // never claimable or actionable (the claim/action guards are status
  // allow-lists, so WITHDRAWN is excluded by construction). Mirrors
  // PendingEditStatus.WITHDRAWN.
  WITHDRAWN
}

enum ValidationMethod {
  PIN
  QR_SCAN
  MANUAL
}

enum PendingEditStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum OnboardingStep {
  REGISTERED
  BRANCH_ADDED
  CONTRACT_SIGNED
  RMV_CONFIGURED
  SUBMITTED
  UNDER_REVIEW // M3: an admin claimed the submission to review it
  APPROVED
  LIVE
  SUSPENDED
  NEEDS_CHANGES
  REJECTED // M3: admin rejected the submission (reopenable)
}

// ─────────────────────────────────────────
// VOUCHERS
// ─────────────────────────────────────────

model Voucher {
  id              String         @id @default(uuid())
  merchantId      String
  code            String         @unique
  isMandatory     Boolean        @default(false)
  type            VoucherType
  title           String
  description     String?
  terms           String?
  imageUrl        String?
  estimatedSaving Decimal        @db.Decimal(10, 2)
  expiryDate      DateTime?
  cooldownSeconds Int? // REUSABLE only; null = platform default (4h);
  // server-clamped to floor 1800s at redemption time.
  status          VoucherStatus  @default(DRAFT)
  approvalStatus  ApprovalStatus @default(PENDING)
  approvalComment String?
  approvedAt      DateTime?
  approvedBy      String?
  isRmv           Boolean        @default(false)
  rmvTemplateId   String?
  merchantFields  Json?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // SEC-C3: seed/demo data flag (see Merchant.isTestData).
  isTestData      Boolean        @default(false)

  merchant            Merchant                    @relation(fields: [merchantId], references: [id])
  redemptions         VoucherRedemption[]
  cycleStates         UserVoucherCycleState[]
  favouritedBy        FavouriteVoucher[]
  rmvTemplate         RmvTemplate?                @relation(fields: [rmvTemplateId], references: [id])
  availabilityWindows VoucherAvailabilityWindow[]
  pendingEdits        VoucherPendingEdit[]

  @@index([merchantId])
  @@index([status])
  @@index([approvalStatus])
  @@index([code])
  @@index([isRmv])
  @@index([isTestData])
}

// TIME_LIMITED voucher availability windows (M4 — recurring weekly only).
// Each row = one window-occurrence per week. Cross-midnight uses the
// special closeTime sentinel "24:00" (next-day midnight boundary);
// see docs/superpowers/specs/2026-05-10-voucher-detail-m4-time-limited-design.md §3.2.
model VoucherAvailabilityWindow {
  id        String @id @default(uuid())
  voucherId String
  dayOfWeek Int // 0=Sun, 1=Mon, ..., 6=Sat (matches BranchOpeningHours)
  openTime  String // "HH:mm" wall-clock, Europe/London ("00:00"-"23:59")
  closeTime String // "HH:mm" wall-clock, Europe/London ("00:01"-"23:59" OR "24:00" sentinel)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

// ─────────────────────────────────────────
// VOUCHER PENDING EDIT (governed flows, 2026-07-07)
// ─────────────────────────────────────────

// Voucher governed flows D1: ONE shared staging record for BOTH governed voucher
// lanes, discriminated by `kind`:
//   CHANGE — a merchant-requested edit to a LIVE (ACTIVE) flagship (isRmv:true)
//     voucher. `proposedChanges` holds ONLY keys from the voucher's
//     RmvTemplate.allowedFields intersected with the promotable top-level set
//     (title / description / estimatedSaving / terms / imageUrl); the applier
//     re-applies its own allow-list (never blind-spread).
//   END — a merchant request to end (deactivate) a LIVE CUSTOM (isRmv:false)
//     voucher. `proposedChanges` is null; the applier flips ACTIVE -> INACTIVE.
//     D4: flagship vouchers are NEVER endable (writer + applier both reject).
// Mirrors MerchantPendingEdit / BranchPendingEdit; reviewed via
// AdminApproval{type:VOUCHER_EDIT, referenceId: <this id>} + editApplier.
enum VoucherEditKind {
  CHANGE
  END
}

model VoucherPendingEdit {
  id              String            @id @default(uuid())
  voucherId       String
  merchantId      String
  kind            VoucherEditKind
  proposedChanges Json?
  reason          String?
  status          PendingEditStatus @default(PENDING)
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  voucher  Voucher  @relation(fields: [voucherId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([voucherId, status])
  @@index([merchantId, status])
}

// ─────────────────────────────────────────
// VOUCHER REDEMPTION (the event record)
// ─────────────────────────────────────────

model VoucherRedemption {
  id               String            @id @default(uuid())
  userId           String
  voucherId        String
  branchId         String
  redemptionCode   String            @unique
  validatedById    String?
  validationMethod ValidationMethod?
  isValidated      Boolean           @default(false)
  validatedAt      DateTime?
  estimatedSaving  Decimal           @db.Decimal(10, 2)
  redeemedAt       DateTime          @default(now())

  // M4a-6.1: window-occurrence claim column for TIME_LIMITED race protection.
  // Set to the current window-occurrence's startsAt at redemption time for
  // TIME_LIMITED vouchers; null for all other voucher types. Combined with
  // @@unique([userId, voucherId, windowStartsAt]) below, this enforces
  // "one redemption per (user, voucher, window-occurrence)" at the DB
  // level — Postgres NULLs are distinct in unique indexes so non-TIME_LIMITED
  // rows don't conflict.
  windowStartsAt DateTime?

  // §DG (spec 2026-05-23-popular-ranking-design.md §6.1). True for
  // redemptions created by QA / test paths — seed data, prisma/qa-*.ts
  // scripts, integration test fixtures.  Filtered out of Popular ranking
  // (`buildPopularRail`) + Trending inclusion query (`buildTrendingRail`)
  // so the popularity signal reflects real customers.  Default false →
  // every existing row defaults to real-customer; only seed/QA paths
  // explicitly set true going forward.
  isTestData Boolean @default(false)

  user             User                        @relation(fields: [userId], references: [id])
  voucher          Voucher                     @relation(fields: [voucherId], references: [id])
  branch           Branch                      @relation(fields: [branchId], references: [id])
  validatedBy      BranchUser?                 @relation(fields: [validatedById], references: [id])
  screenshotEvents RedemptionScreenshotEvent[]
  // PR-C 2026-05-09: at most one verified review per redemption
  // (Review.redemptionId is @unique).  Back-relation; not a column.
  review           Review?

  // M4a-6.1: window-occurrence claim — DB-level guarantee that no two
  // TIME_LIMITED redemptions can land in the same (user, voucher,
  // window-occurrence). NULLs distinct so non-TIME_LIMITED unaffected.
  @@unique([userId, voucherId, windowStartsAt])
  @@index([userId])
  @@index([voucherId])
  @@index([branchId])
  @@index([redeemedAt])
  @@index([userId, voucherId])
  @@index([redemptionCode])
  @@index([isTestData])
}

// ─────────────────────────────────────────
// REDEMPTION SCREENSHOT EVENT
// Anti-fraud telemetry: records when a customer takes a screenshot of
// the Show-to-Staff surface (iOS — Android blocks via FLAG_SECURE).
// Best-effort: write must never block the customer surface. Deduped
// at the Redis layer (5s SETNX) before reaching this table — see
// flagRedemptionScreenshot service.
// ─────────────────────────────────────────

model RedemptionScreenshotEvent {
  id           String   @id @default(uuid())
  userId       String
  redemptionId String
  // 'ios' | 'android' — also enforced at the DB layer via the
  // CHECK constraint `RedemptionScreenshotEvent_platform_check`
  // (migration `20260510033746_redemption_screenshot_event_platform_check`).
  // Prisma 7 has no inline `@@check` syntax; the migration is the
  // source of truth.  Closes deferred-followups §AG3.
  platform     String
  occurredAt   DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id])
  redemption VoucherRedemption @relation(fields: [redemptionId], references: [id])

  @@index([redemptionId, occurredAt])
  @@index([userId])
}

// ─────────────────────────────────────────
// USER VOUCHER CYCLE STATE
// One row per (user x voucher). Source of truth for monthly cycle enforcement.
// Reset isRedeemedInCurrentCycle=false when subscription renews.
// ─────────────────────────────────────────

model UserVoucherCycleState {
  id                       String    @id @default(uuid())
  userId                   String
  voucherId                String
  cycleStartDate           DateTime
  isRedeemedInCurrentCycle Boolean   @default(false)
  lastRedeemedAt           DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId])
  @@index([userId])
  @@index([isRedeemedInCurrentCycle])
}

// ─────────────────────────────────────────
// ENUMS (subscription)
// ─────────────────────────────────────────

enum SubscriptionStatus {
  TRIALLING
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_GBP
}

// ─────────────────────────────────────────
// SUBSCRIPTION PLAN (admin-managed)
// ─────────────────────────────────────────

model SubscriptionPlan {
  id              String          @id @default(uuid())
  name            String
  description     String?
  priceGbp        Decimal         @db.Decimal(10, 2)
  billingInterval BillingInterval
  stripePriceId   String          @unique
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions Subscription[]
}

// ─────────────────────────────────────────
// USER SUBSCRIPTION
// ─────────────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  planId               String
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  promoCodeId          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Immutable after creation. Defines the day-of-month on which the user's
  // monthly voucher cycle resets. Set once by whichever payment flow creates
  // the subscription (Stripe, Apple IAP, Google Play, or admin-grant).
  // Stored as midnight UTC on the anchor day.
  //
  // RESUBSCRIBE: When a user resubscribes after cancellation, a NEW
  // Subscription record is created with a fresh cycleAnchorDate. If
  // reactivation logic is added later (updating the existing record instead
  // of creating a new one), it MUST explicitly reset cycleAnchorDate.
  cycleAnchorDate DateTime

  user      User             @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  promoCode PromoCode?       @relation(fields: [promoCodeId], references: [id])

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([currentPeriodEnd])
