// TIME_LIMITED voucher availability windows (M4 — recurring weekly only).
// Each row = one window-occurrence per week. Cross-midnight uses the
// special closeTime sentinel "24:00" (next-day midnight boundary);
// see docs/superpowers/specs/2026-05-10-voucher-detail-m4-time-limited-design.md §3.2.
model VoucherAvailabilityWindow {
  id        String @id @default(uuid())
  voucherId String
  dayOfWeek Int // 0=Sun, 1=Mon, ..., 6=Sat (matches BranchOpeningHours)
  openTime  String // "HH:mm" wall-clock, Europe/London ("00:00"-"23:59")
  closeTime String // "HH:mm" wall-clock, Europe/London ("00:01"-"23:59" OR "24:00" sentinel)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

// ─────────────────────────────────────────
// VOUCHER REDEMPTION (the event record)
// ─────────────────────────────────────────

model VoucherRedemption {
  id               String            @id @default(uuid())
  userId           String
  voucherId        String
  branchId         String
  redemptionCode   String            @unique
  validatedById    String?
  validationMethod ValidationMethod?
  isValidated      Boolean           @default(false)
  validatedAt      DateTime?
  estimatedSaving  Decimal           @db.Decimal(10, 2)
  redeemedAt       DateTime          @default(now())

  // M4a-6.1: window-occurrence claim column for TIME_LIMITED race protection.
  // Set to the current window-occurrence's startsAt at redemption time for
  // TIME_LIMITED vouchers; null for all other voucher types. Combined with
  // @@unique([userId, voucherId, windowStartsAt]) below, this enforces
  // "one redemption per (user, voucher, window-occurrence)" at the DB
  // level — Postgres NULLs are distinct in unique indexes so non-TIME_LIMITED
  // rows don't conflict.
  windowStartsAt DateTime?

  // §DG (spec 2026-05-23-popular-ranking-design.md §6.1). True for
  // redemptions created by QA / test paths — seed data, prisma/qa-*.ts
  // scripts, integration test fixtures.  Filtered out of Popular ranking
  // (`buildPopularRail`) + Trending inclusion query (`buildTrendingRail`)
  // so the popularity signal reflects real customers.  Default false →
  // every existing row defaults to real-customer; only seed/QA paths
  // explicitly set true going forward.
  isTestData Boolean @default(false)

  user             User                        @relation(fields: [userId], references: [id])
  voucher          Voucher                     @relation(fields: [voucherId], references: [id])
  branch           Branch                      @relation(fields: [branchId], references: [id])
  validatedBy      BranchUser?                 @relation(fields: [validatedById], references: [id])
  screenshotEvents RedemptionScreenshotEvent[]
  // PR-C 2026-05-09: at most one verified review per redemption
  // (Review.redemptionId is @unique).  Back-relation; not a column.
  review           Review?

  // M4a-6.1: window-occurrence claim — DB-level guarantee that no two
  // TIME_LIMITED redemptions can land in the same (user, voucher,
  // window-occurrence). NULLs distinct so non-TIME_LIMITED unaffected.
  @@unique([userId, voucherId, windowStartsAt])
  @@index([userId])
  @@index([voucherId])
  @@index([branchId])
  @@index([redeemedAt])
  @@index([userId, voucherId])
  @@index([redemptionCode])
  @@index([isTestData])
}

// ─────────────────────────────────────────
// REDEMPTION SCREENSHOT EVENT
// Anti-fraud telemetry: records when a customer takes a screenshot of
// the Show-to-Staff surface (iOS — Android blocks via FLAG_SECURE).
// Best-effort: write must never block the customer surface. Deduped
// at the Redis layer (5s SETNX) before reaching this table — see
// flagRedemptionScreenshot service.
// ─────────────────────────────────────────

model RedemptionScreenshotEvent {
  id           String   @id @default(uuid())
  userId       String
  redemptionId String
  // 'ios' | 'android' — also enforced at the DB layer via the
  // CHECK constraint `RedemptionScreenshotEvent_platform_check`
  // (migration `20260510033746_redemption_screenshot_event_platform_check`).
  // Prisma 7 has no inline `@@check` syntax; the migration is the
  // source of truth.  Closes deferred-followups §AG3.
  platform     String
  occurredAt   DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id])
  redemption VoucherRedemption @relation(fields: [redemptionId], references: [id])

  @@index([redemptionId, occurredAt])
  @@index([userId])
}

// ─────────────────────────────────────────
// USER VOUCHER CYCLE STATE
// One row per (user x voucher). Source of truth for monthly cycle enforcement.
// Reset isRedeemedInCurrentCycle=false when subscription renews.
// ─────────────────────────────────────────

model UserVoucherCycleState {
  id                       String    @id @default(uuid())
  userId                   String
  voucherId                String
  cycleStartDate           DateTime
  isRedeemedInCurrentCycle Boolean   @default(false)
  lastRedeemedAt           DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId])
  @@index([userId])
  @@index([isRedeemedInCurrentCycle])
}

