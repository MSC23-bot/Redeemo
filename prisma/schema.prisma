  title           String
  description     String?
  terms           String?
  imageUrl        String?
  estimatedSaving Decimal        @db.Decimal(10, 2)
  expiryDate      DateTime?
  cooldownSeconds Int? // REUSABLE only; null = platform default (4h);
  // server-clamped to floor 1800s at redemption time.
  status          VoucherStatus  @default(DRAFT)
  approvalStatus  ApprovalStatus @default(PENDING)
  approvalComment String?
  approvedAt      DateTime?
  approvedBy      String?
  isRmv           Boolean        @default(false)
  rmvTemplateId   String?
  merchantFields  Json?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // SEC-C3: seed/demo data flag (see Merchant.isTestData).
  isTestData      Boolean        @default(false)

