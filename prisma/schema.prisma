enum LocationConfidence {
  MANUALLY_CONFIRMED
  ADDRESS_GEOCODED
  POSTCODE_CENTROID
  NEEDS_REVIEW
  // Branch Location Trust Slice 3 (spec 2026-07-09 pin-drop addendum, APPROVED):
  // a merchant self-asserted pin, verified server-side to sit within the
  // postcode-area sanity radius (LOCATION_TRUST_RADIUS_METRES). It is the WEAKEST
  // member of the customer-visible confirmed set (CONFIRMED_LOCATION_SET): the
  // Google path has two independent signals (geocode + postcode match) plus the
  // radius; a pin-drop has only the radius. googlePlaceId stays null (there is no
  // Google place). Sole writer-authority: the pin-drop endpoint (dropBranchPin);
  // labelled "Merchant-set pin" in the admin panel, never "verified".
  MERCHANT_CONFIRMED
}

// Branches PR-5 (D5): the branch lifecycle staging axis (status-on-Branch).
// Orthogonal to Branch.isActive (reversible suspend) and Branch.deletedAt
// (permanent soft-delete). Default LIVE makes the column a no-op for all existing
// rows + the instant onboarding-first-branch / admin-create-draft path.
enum BranchLifecycleStatus {
  PENDING_CREATE
  LIVE
  PENDING_CLOSE
  CLOSED
}

enum LadderProfile {
  LOCAL_TIGHT
  LOCAL_NORMAL
  MIXED_NORMAL
  DESTINATION_LOCAL
  DESTINATION_WIDE
}

// ─────────────────────────────────────────
// LOCALITY (Plan 4 — named place / settlement)
// ─────────────────────────────────────────

model Locality {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  postTown       String?
  ladDistrict    String
  adminCounty    String?
  region         String?
  country        String
  centerLat      Decimal        @db.Decimal(10, 8)
  centerLng      Decimal        @db.Decimal(11, 8)
  populationTier PopulationTier @default(UNKNOWN)
  marketId       String?
  needsReview    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  market                 Market?                 @relation("LocalityMarket", fields: [marketId], references: [id])
  marketAnchorOf         Market?                 @relation("MarketAnchor")
  outgoingCatchmentEdges LocalityCatchmentEdge[] @relation("CatchmentSource")
  incomingCatchmentEdges LocalityCatchmentEdge[] @relation("CatchmentTarget")
  branches               Branch[]                @relation("BranchLocality")
  users                  User[]                  @relation("UserLocality")

  // Plan 4 M1 PR #81 review — identity tuple. Two Localities in the same
  // (ladDistrict, country) cannot share a name. Pins the seed-generator
  // invariant at the DB level + auto-creates the composite index needed
  // by findExistingLocality (M1.18 / M1.19) for runtime tuple-lookup.
  //
  // Why this matters: postcodes.io parish names come through as bare
  // ("Langley") or parenthetical ("Langley (Uttlesford)") for ambiguous
  // parishes. Both can exist in the same LAD. Pre-fix, slug-based lookup
  // could resolve a postcode for the bare-name parish to the parenthetical
  // disambiguator's Locality (or vice versa) because slug("Langley") +
  // LAD-suffix collides with slugify("Langley (Uttlesford)"). Tuple-match
  // by (name, ladDistrict, country) is the correct identity.
  @@unique([name, ladDistrict, country])
  @@index([marketId])
  @@index([populationTier])
  @@index([country])
  @@index([centerLat, centerLng])
}

// ─────────────────────────────────────────
// LOCALITY CATCHMENT EDGE (Plan 4 — directed catchment graph)
// ─────────────────────────────────────────

model LocalityCatchmentEdge {
  id               String   @id @default(uuid())
  sourceLocalityId String
  targetLocalityId String
  rank             Int      @default(1)
  isCurated        Boolean  @default(false)
  createdAt        DateTime @default(now())

  source Locality @relation("CatchmentSource", fields: [sourceLocalityId], references: [id], onDelete: Cascade)
  target Locality @relation("CatchmentTarget", fields: [targetLocalityId], references: [id], onDelete: Cascade)

  @@unique([sourceLocalityId, targetLocalityId])
  @@index([targetLocalityId])
}

// ─────────────────────────────────────────
// MARKET (Plan 4 — geographic trading area)
// ─────────────────────────────────────────

model Market {
  id                  String       @id @default(uuid())
  name                String
  slug                String       @unique
  status              MarketStatus @default(PAUSED)
  anchorLocalityId    String       @unique
  ladDistrict         String?
  adminCounty         String?
  region              String?
  country             String
  targetMerchantCount Int?
  launchedAt          DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  anchorLocality     Locality   @relation("MarketAnchor", fields: [anchorLocalityId], references: [id])
  includedLocalities Locality[] @relation("LocalityMarket")

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Encryption key-rotation R1 (spec §3.9 / §5; Amendment R3-#1).
//
// Each running service (web + worker) publishes its canonical keyring fingerprint
// here at boot (and refreshes lastSeenAt). R1 BOTH publishes these rows AND its
// deploy gate reads them, so the table is created + applied in R1. A future
// migrator reads parity DIRECTLY from this table — no HTTP endpoint, no admin
// credential. The fingerprint is the §3.9 domain-separated digest (codeCapability
// + active kids + sorted per-key keyHash); it NEVER contains raw key bytes.
// `service` is the unique key (one row per service) so a boot re-publish upserts.
// ─────────────────────────────────────────────────────────────────────────────
model KeyringFingerprint {
  id             String   @id @default(uuid())
  service        String   @unique
  fingerprint    String
  codeCapability String
  bootedAt       DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
}

// How a prospect first entered the recruitment pipeline. Owner-locked set
// (grill-me 2026-07-10, OD1). CUSTOMER_REQUEST is the future intake from the
// customer app's deferred "Request a merchant" entry point.
enum MerchantSource {
  REP_VISIT
  INBOUND_ENQUIRY
  PHONE
  SOCIAL
  EMAIL_CAMPAIGN
  CUSTOMER_REQUEST
}

// Prospect pipeline position. LEAD/CONTACTED/VISIT_BOOKED are the three kanban
// lanes; CONVERTED and LOST are terminal STATES surfaced as filters, not lanes
// (OD1). LOST always carries a lostReason and is audited.
enum LeadStage {
  LEAD
  CONTACTED
  VISIT_BOOKED
  CONVERTED
  LOST
}

// Recruitment pipeline prospect. Net-new; the front half of onboarding before a
// merchant draft exists. On convert, `convertedMerchantId` is stamped and the
// existing create-draft flow runs. UK-GDPR: Lost or stale-untouched (no activity
// for 6 months) leads are auto-anonymised by a scheduled job that nulls the three
// contact fields and sets `anonymisedAt`, retaining businessName/category/location
// /outcome for funnel analytics. Converted leads are exempt (they keep the link).
// `assignedRepId` / `convertedMerchantId` are intentionally FK-free to keep this
// packet additive within the bundled migration window; integrity is enforced in
// the service layer.
model MerchantLead {
  id                  String         @id @default(uuid())
  businessName        String
  categoryGuess       String?
  locationHint        String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  source              MerchantSource?
  stage               LeadStage      @default(LEAD)
  nextAction          String?
  dueDate             DateTime?
  assignedRepId       String?
  lostReason          String?
  convertedMerchantId String?
  lastActivityAt      DateTime       @default(now())
  anonymisedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([stage])
  @@index([assignedRepId])
  @@index([dueDate])
  @@index([anonymisedAt, lastActivityAt]) // anonymisation sweep predicate (anonymisedAt IS NULL + lastActivityAt < cutoff)
}

// ─────────────────────────────────────────
// MERCHANT NOTE (internal admin notes, packet 2026-07-13)
// ─────────────────────────────────────────

// Lifecycle state of a note. ACTIVE notes are editable/retractable by their
// author; RETRACT is a SOFT delete (status -> RETRACTED, body preserved).
enum MerchantNoteStatus {
  ACTIVE
  RETRACTED
}

// The three note lifecycle actions, each appended as a MerchantNoteEvent.
enum MerchantNoteAction {
  ADDED
  EDITED
  RETRACTED
}

// Internal per-merchant admin note (D51 Merchant 360 Tab 8; owner-locked OD2
// grill-me 2026-07-10). Readable + writable by ALL admin roles via the universal
// `merchant:notes` capability (src/api/admin/capability.ts). Notes are NEVER hard-
// deleted: a retract soft-deletes (status RETRACTED + retractedBy/At/Reason, body
// preserved). Edit and retract are OWN + ACTIVE only (author == the acting admin);
// v1 has no moderation override (not even SUPER_ADMIN edits/retracts another
// author's note). Every mutation appends a MerchantNoteEvent (ADDED /
// EDITED-with-priorBody / RETRACTED-with-reason). No customer personal data
// belongs in a note body (DSAR content lives elsewhere; UI hint later).
// authorAdminId / retractedById are plain AdminUser id strings (NO FK): three
// admin-referencing columns across these two tables would form a growing FK web,
// so they follow the MerchantLead.assignedRepId / AdminApproval.claimedById
// bare-id precedent; integrity is enforced in the service layer. The structural
// parent relation (merchantId) keeps a real RESTRICT FK (like AdminCapabilityGrant),
// and MerchantNote is a leaf table, so the migration stays create-only.
model MerchantNote {
  id              String              @id @default(uuid())
  merchantId      String
  merchant        Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  authorAdminId   String
  body            String
  status          MerchantNoteStatus  @default(ACTIVE)
  editedAt        DateTime?
  retractedById   String?
  retractedAt     DateTime?
  retractedReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  events          MerchantNoteEvent[]

  @@index([merchantId, createdAt])
}

// Append-only history for a MerchantNote: one row per lifecycle action. priorBody
// is set on EDITED only (the version being replaced); reason on RETRACTED only.
// actorAdminId is a plain AdminUser id string (see the MerchantNote FK note). The
// structural parent relation (noteId) keeps a real RESTRICT FK.
model MerchantNoteEvent {
  id           String             @id @default(uuid())
  noteId       String
  note         MerchantNote       @relation(fields: [noteId], references: [id], onDelete: Restrict)
  action       MerchantNoteAction
  actorAdminId String
  priorBody    String?
  reason       String?
  createdAt    DateTime           @default(now())

  @@index([noteId, createdAt])
}
