{
  "name": "redeemo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "test": "vitest run",
    "test:vercel-build-decision": "node --test scripts/vercel-build-decision/__tests__/*.test.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:insights": "vitest run --project integration tests/api/merchant/insights",
    "test:integration:maintenance": "vitest run --project integration tests/api/queues/maintenanceSweep.integration.test.ts tests/api/admin/claim-stale-sweep.integration.test.ts tests/api/queues/processors/promotePendingHours.integration.test.ts tests/api/queues/maintenanceAlerts.integration.test.ts",
    "test:integration:invites": "vitest run --project integration tests/api/customer/invites",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "insights:demo:seed": "tsx prisma/insights-demo-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "apple-signin-auth": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.7",
    "pdfkit": "^0.15.2",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "resend": "^6.10.0",
    "stripe": "^22.0.1",
    "svix": "^1.90.0",
    "twilio": "^5.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.3",
    "csv-parse": "^6.2.1",
    "glob": "^13.0.6",
    "shadcn": "^4.11.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
