# ─── Redeemo backend (src/api) environment ───────────────────────────────────
# REQUIRED secrets are validated FAIL-CLOSED at boot (src/api/shared/env.ts):
# the API refuses to start if any is missing or left as a placeholder.
# Copy this file to `.env`, fill in REAL values, and NEVER commit `.env`.
# Generate a 32-byte hex secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Database (Neon Postgres) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Redis (sessions + rate-limit store + BullMQ queues) ──
# ONE instance per environment. BullMQ (the worker process) SHARES this instance
# for MVP (its own ioredis connection + the BULLMQ_PREFIX below so keys never
# collide with sessions/limiters). OPERATIONAL REQUIREMENT: set the Redis
# instance to `maxmemory-policy noeviction` — BullMQ cannot tolerate key eviction
# (a dropped job key = a lost job). Sessions + TTL'd rate-limit keys are
# unaffected by noeviction (they expire, never evicted). See the runbook
# "Phase 0 foundations" section.
REDIS_URL="redis://localhost:6379"

# ── AES-256-GCM encryption key (branch PINs, etc.) — 64-char hex ──
ENCRYPTION_KEY="REPLACE_ME-64-char-hex"

# ── JWT signing secrets — ONE PER ROLE, keep them DISTINCT (generate each) ──
JWT_SECRET_CUSTOMER="REPLACE_ME-customer"
JWT_SECRET_MERCHANT="REPLACE_ME-merchant"
JWT_SECRET_BRANCH="REPLACE_ME-branch"
JWT_SECRET_ADMIN="REPLACE_ME-admin"

# ── Stripe ──
STRIPE_SECRET_KEY="REPLACE_ME-sk_test_or_live"
STRIPE_WEBHOOK_SECRET="REPLACE_ME-whsec"

# ── PR2b production-safe REFERENCE seed (prisma/seed-reference.ts) ──
# Loads reference/config data (taxonomy / localities / markets / subscription
# plans / CMS placeholders) into a target DB WITHOUT the full dev/demo seed.
# Safe with NODE_ENV=production; needs NO ENCRYPTION_KEY. All gates fail closed.
# See docs/runbooks/deploy-security-runbook.md §4 step 2 + §8. Only the reference
# seed reads the vars below — the full dev seed uses dev placeholder plan ids.
#   ALLOW_REFERENCE_SEED="true"                  # explicit opt-in (required)
#   REFERENCE_SEED_CONFIRM="<unique-db-host>"    # must appear in the printed target DB
# Prefer the UNIQUE Neon host (e.g. ep-xxxx.eu-west-2.aws.neon.tech); do NOT use a
# generic database name like "neondb" if multiple environments share it.
# REAL Stripe price ids for the subscription plans — the reference seed REJECTS
# missing / placeholder / dev values (e.g. price_monthly_dev). Set these up in
# Stripe first.
#   STRIPE_PRICE_ID_MONTHLY="price_REPLACE_ME"
#   STRIPE_PRICE_ID_ANNUAL="price_REPLACE_ME"

# ── Twilio (SMS OTP — live) ──
TWILIO_ACCOUNT_SID="REPLACE_ME-AC..."
TWILIO_AUTH_TOKEN="REPLACE_ME"
TWILIO_VERIFY_SERVICE_SID="REPLACE_ME-VA..."
TWILIO_FROM_NUMBER="REPLACE_ME-+44..."

# ── SEC-H3 SMS/OTP toll-fraud controls (src/api/shared/smsLimiter.ts) ──
# Country allowlist for SMS destinations — comma-separated FULL E.164 country
# codes (e.g. "+44" or "+44,+353"). Default UK-only. ALWAYS enforced
# (RATE_LIMIT_RELAX does NOT disable it). Each value must be a complete assigned
# country code, NOT a partial prefix: an invalid entry like "+4" is dropped (with
# a boot warning) and ignored — it does NOT widen the allowlist to +40…+49. If
# all entries are invalid/unset, it falls back to UK-only (+44).
# SMS_ALLOWED_COUNTRY_CODES="+44"
# Global daily SMS cost circuit-breaker (hard block when reached). Default 500.
# ALWAYS enforced in production. Raise as legitimate volume grows; pair with
# alerting. (Dev can raise this if heavy local QA hits it.)
# SMS_GLOBAL_DAILY_CAP="500"
# NOTE: per-phone/user/IP hourly+daily caps + the 45s resend cooldown are loosened
# in local/dev ONLY when RATE_LIMIT_RELAX=true (never in production).

# ── SEC-H4 password-reset request limiter (src/api/shared/pwdResetLimiter.ts) ──
# Forgot-password requests are rate-limited per-email (3/hour + 5/day) and per-IP
# (10/day), in addition to the per-IP hourly @fastify/rate-limit edge tier on the
# route. No env var configures this; the caps are loosened in local/dev ONLY when
# RATE_LIMIT_RELAX=true (never in production). Counters are Redis-only (no migration).

# ─── Optional / non-secret config (not boot-validated) ───────────────────────
# CORS allowlist: comma-separated browser origins allowed to call the API.
# Defaults to http://localhost:3001 + http://localhost:3002 + http://localhost:3003
# (customer-web + admin-web + merchant-web) if unset. Production MUST include the
# admin and merchant portal origins alongside the web origins:
# https://admin.redeemo.co.uk and https://merchant.redeemo.co.uk
# CORS_ORIGIN="https://redeemo.co.uk,https://www.redeemo.co.uk,https://admin.redeemo.co.uk,https://merchant.redeemo.co.uk"

# Proxy trust for req.ip / IP-based rate limiting (SEC-H2). Default OFF (local).
# Behind a hosting proxy the socket peer is the proxy, so set this to the number
# of proxy hops so req.ip reads the real client (single-proxy PaaS = 1).
#   - unset / false / 0       → off (local dev; X-Forwarded-For ignored)
#   - a hop count, e.g. 1     → trust the last N proxy hops (RECOMMENDED hosted)
#   - true                    → trust all hops (discouraged; only if the edge
#                               rewrites X-Forwarded-For so it can't be spoofed)
#   - a comma-separated IP/CIDR allowlist → trust only those proxy addresses
# Railway/Render API + staging: TRUST_PROXY=1 (verify req.ip on the deployed host).
# TRUST_PROXY=1

# Google Places API — used by TWO callers, both server-side (see
# docs/superpowers/specs/2026-05-14-merchant-exact-pin-confirmation-design.md
# and docs/operations/google-places-setup.md):
#   1. prisma/suggest-branch-pin.ts (owner-run CLI, admin pin confirmation).
#   2. The SHIPPED merchant-portal branch address search (PR #318) — the
#      merchant-facing "search your business address" flow at
#      POST /api/v1/merchant/location/search, backed by
#      src/api/merchant/location/service.ts + searchPlaces(). NOT optional in
#      any environment where address search should work: without this key the
#      route returns LOCATION_SEARCH_UNAVAILABLE (client-safe collapse of
#      every provider-side failure, including a missing/expired key).
#   - API restriction: Places API (New) ONLY.
#   - Local daily/monthly hard-stops in src/api/lib/googlePlaces.ts (500/day,
#     4,500/month, shared across both callers) replace the unavailable
#     Google-side quota cap (spec §4.8). The merchant-portal route additionally
#     sits behind its own Redis atomic limiter
#     (src/api/shared/merchantLocationLimiter.ts, PR #318) before either cap.
GOOGLE_MAPS_API_KEY=

# NOTE: NEXT_PUBLIC_* (customer-web) live in apps/customer-web/.env.local.

# ── Storage / Cloudflare R2 (S3-compatible) — Phase 0 PR-0.5 (library, ships DARK) ──
# src/api/shared/storage.ts presigns uploads/downloads but stays OFF by default.
# With STORAGE_ENABLED unset/false NOTHING presigns and the R2_* secrets are NOT
# required (the backend boots without them). When STORAGE_ENABLED=true, ALL of
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_ENDPOINT / R2_BUCKET /
# R2_PUBLIC_BUCKET / R2_PUBLIC_BASE_URL are required (fail-closed). No upload
# ROUTE exists yet — the capability-checked route is Phase 2. R2_ACCOUNT_ID is
# reference only (the endpoint embeds it) and is not gate-required.
#
# Two-bucket split (owner decision 2026-07-09): documents and public media are
# PHYSICALLY SEPARATE buckets, not a policy flag on one shared bucket —
#   - R2_BUCKET        = the PRIVATE bucket (verification documents only; never
#                        given a public base URL; accessed only via presignGet).
#   - R2_PUBLIC_BUCKET = the PUBLIC bucket (logo / banner / photo).
#   - R2_PUBLIC_BASE_URL = the PUBLIC bucket's public base URL (r2.dev / a
#                        custom domain) — it must point at R2_PUBLIC_BUCKET,
#                        never at R2_BUCKET.
STORAGE_ENABLED=false                                   # gates presign issuance (default OFF)
R2_ACCOUNT_ID=                                          # reference only (endpoint embeds it)
# R2_ACCESS_KEY_ID=                                     # required when STORAGE_ENABLED=true
# R2_SECRET_ACCESS_KEY=                                 # required when STORAGE_ENABLED=true
R2_BUCKET=redeemo-staging                               # PRIVATE bucket (documents only)
R2_PUBLIC_BUCKET=redeemo-public-staging                 # PUBLIC bucket (logo/banner/photo)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # S3-compatible R2 endpoint
R2_PUBLIC_BASE_URL=https://media-staging.redeemo.co.uk      # PUBLIC bucket's public base URL

# ── Email / Resend (Phase 0 PR-0.3 — the client wrapper; ships DARK) ──────────
# The Resend client (src/api/shared/email.ts) is wired but stays OFF by default.
# With EMAIL_ENABLED unset/false NOTHING is sent and RESEND_API_KEY is not even
# required (the backend boots without it). Production email stays OFF until the
# runbook §6 pre-send HARD gates are met: §SEC.1 atomic limiter (done) + Resend
# domain verification + SPF/DKIM/DMARC + monitored inbound mailboxes + bounce/
# complaint webhooks → CommunicationLog. Staging flips EMAIL_ENABLED=true with a
# SEPARATE key + EMAIL_SANDBOX=true so no test mail reaches a real address.
# See docs/runbooks/deploy-security-runbook.md §6.
EMAIL_ENABLED=false                                  # OUTBOUND master switch (default OFF)
EMAIL_SANDBOX=true                                   # staging: redirect every recipient to the allowlist
EMAIL_SANDBOX_ALLOWLIST=qa@redeemo.co.uk             # comma-separated; sandbox-only redirect targets
# RESEND_API_KEY=                                    # required only when EMAIL_ENABLED=true
RESEND_FROM_EMAIL="Redeemo <noreply@redeemo.co.uk>"            # D-F default sender
RESEND_REPLY_TO="support@redeemo.co.uk"                        # D-F reply-to
RESEND_MERCHANT_FROM="Redeemo Merchants <merchants@redeemo.co.uk>"  # D-F merchant sender (sender:'merchant')
# Resend bounce/complaint webhook (PR-0.4). The route self-gates on this secret's
# PRESENCE — independent of EMAIL_ENABLED — so bounce/complaint events are still
# received even when OUTBOUND sending is paused. Unset ⇒ the route is not
# registered. It is the Svix signing secret from the Resend dashboard (whsec_…),
# verified against the raw request body via the `svix` package.
# RESEND_WEBHOOK_SECRET=whsec_xxx                     # enables /api/v1/resend/webhook when set

# Admin ops alert inbox (M8). When a merchant submits for approval, an EMAIL alert
# is sent here (the in-app admin bell fan-out always fires regardless). Unset/empty
# ⇒ the email alert is SKIPPED but the bell notifications are still written. Like
# all outbound email it is governed by EMAIL_ENABLED — dark by default. Resubmits
# email the reviewer who requested the changes, not this inbox.
# ADMIN_OPS_ALERT_EMAIL=ops@redeemo.co.uk

# ── Captcha / Cloudflare Turnstile (M1 Slice R: merchant self-serve register) ──
# Gates the Turnstile siteverify check on POST /api/v1/merchant/auth/register.
# With CAPTCHA_ENABLED unset/false the verify helper SKIPS (no network call) and
# TURNSTILE_SECRET_KEY is NOT required (dev/CI/test boot without it). When
# CAPTCHA_ENABLED=true the secret is required (fail-closed). Dev/test use the
# Cloudflare always-pass test keys; production sets a real secret. The frontend
# Turnstile site key (NEXT_PUBLIC_TURNSTILE_SITE_KEY) lives in merchant-web env.
CAPTCHA_ENABLED=false                                # gates Turnstile verify (default OFF)
# TURNSTILE_SECRET_KEY=                              # required only when CAPTCHA_ENABLED=true

# ── Reset-link base URLs (PR-0.4) — used to build password-reset email links ──
# Env-driven with dev defaults; production sets the real hosts (D-C / D-E). No
# default for these is a secret, so they are NOT in REQUIRED_SECRETS.
WEB_APP_URL=http://localhost:3001                    # customer-web (prod: https://redeemo.co.uk)
MERCHANT_PORTAL_URL=https://merchant.redeemo.co.uk   # merchant portal (Phase 4)
ADMIN_PANEL_URL=https://admin.redeemo.co.uk          # admin panel (Phase 5)

# ── Image moderation / photo safeguards (Phase 0 PR-0.6 — ships DARK) ──────────
# The photo-moderation GATE is always on (a BranchPhoto defaults PENDING and is
# invisible to customers until APPROVED). These vars only choose HOW a PENDING
# photo gets resolved. MVP default: no scanner ⇒ photos await ADMIN review (the
# admin photo-review action ships in Phase 2). scanImage() is FAIL-SAFE — any
# non-CLEAN/non-FLAGGED state leaves the photo PENDING, never public.
MODERATION_ENABLED=false                  # master switch; false ⇒ scanImage() returns UNAVAILABLE → photo stays PENDING
MODERATION_PROVIDER=none                  # none | rekognition | sightengine (adapters: Phase 2+, D1)
PHOTO_COUNT_CAP_PER_BRANCH=15             # §12 per-branch photo cap (D5; FLAGGED rows don't count)

# ── Worker / queues (Phase 0) ─────────────────────────────────────────────────
# The worker is a SECOND process (`npm run start:worker` / Procfile `worker`)
# sharing the same env as the API. It runs the email-delivery + outbox-reconciler
# + photo-moderation BullMQ workers against REDIS_URL above.
WORKER_CONCURRENCY=5                       # per-worker BullMQ concurrency (positive int; default 5)
BULLMQ_PREFIX=redeemo                      # key namespace on the shared Redis (default 'redeemo')

# Worker Prisma pool max — REQUIRED whenever the worker starts (normal boot,
# MAINTENANCE_MODE=disabled, AND --verify-keyring-and-exit). Integer 1-10
# inclusive; there is NO silent node-postgres default any more, and the ceiling
# of 10 preserves the previously-inherited maximum (raising it is a reviewed
# code change, never an env bump). The value 5 below is ONLY the
# local-benchmark STAGING CANDIDATE from the 2026-07-01 provider-free pool
# benchmark — it is NOT applied to any live environment by this file, NOT a
# production approval, and the final provider value remains owner/staging-gated
# (set per environment at deploy time). The API service's pool is unaffected.
WORKER_DATABASE_POOL_MAX=5

# ── Maintenance scheduler (Neon CU-burn PR-A — fail-closed, spec §14) ─────────
# MAINTENANCE_MODE=disabled is the ONLY intentional maintenance-off path (worker
# boots WITHOUT the scheduler + a loud log; the values below are then not
# required). Unset/enabled ⇒ maintenance ON ⇒ EVERY value below must be present
# and valid or the worker FAILS STARTUP non-zero. An unsupported mode value also
# fails startup — a bad config is never silently coerced to disabled.
# Numbers are CANDIDATE values; final numerics are benchmark/owner-gated (§15).
MAINTENANCE_MODE=disabled                  # disabled | enabled (unset ⇒ enabled)
MAINTENANCE_FLOOR_IDLE_MS=1800000          # idle sweep cadence; MUST be > 300000 (Neon 5-min scale-to-zero window)
MAINTENANCE_FLOOR_ACTIVE_MS=5000           # backlog-drain cadence while a sweep reports full batches
MAINTENANCE_PHASE_B_MAX_ITEMS=200          # Phase-B per-run item cap
MAINTENANCE_PHASE_B_BUDGET_MS=10000        # Phase-B cooperative time budget (monotonic, checked between rows)
MAINTENANCE_STATEMENT_TIMEOUT_MS=4000      # server-side per-statement bound; MUST be < TX timeout
MAINTENANCE_TX_TIMEOUT_MS=8000             # Prisma interactive-tx bound (rolls back + releases the advisory lock)
MAINTENANCE_SWEEP_OUTBOX_ENABLED=true      # per-sweep enable flag (outbox reconcile on the durable floor)
MAINTENANCE_SWEEP_PENDING_HOURS_ENABLED=true # per-sweep enable flag + rollback switch (opening-hours promotion sweep — PR-B)
MAINTENANCE_SWEEP_CLAIM_STALE_ENABLED=true   # per-sweep enable flag + rollback switch (stale-claim sweep — PR-B)
