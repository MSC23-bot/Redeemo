DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-key-here"

# Google Places API (Phase 1 merchant-pin confirmation only — see
# docs/superpowers/specs/2026-05-14-merchant-exact-pin-confirmation-design.md
# and docs/operations/google-places-setup.md).
# Used by prisma/suggest-branch-pin.ts ONLY. NOT a customer-flow key.
# Recommended restrictions:
#   - API restriction: Places API (New) ONLY (no other Google APIs).
#   - Application restriction: IP allow-list when feasible (owner machine /
#     bastion). Optional — fine to leave unrestricted for local dev.
# NOTE: Google does NOT let us set a per-day quota cap downward on Places
# API (New). The local daily + monthly hard-stops in
# src/api/lib/googlePlaces.ts (defaults: 500/day, 4,500/month) replace the
# unavailable Google-side quota knob. See spec §4.8.
GOOGLE_MAPS_API_KEY=
