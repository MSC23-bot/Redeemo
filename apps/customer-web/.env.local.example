# ─── Redeemo customer website (Next.js) — apps/customer-web/.env.local ───────
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values are inlined at BUILD
# time and are exposed to the browser, so they must NOT be secrets.

# Backend API base URL.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Stripe PUBLISHABLE key (safe for the client). Never the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# SEC-C3 marketplace gate. Default OFF (pre-launch) hides /discover, /map,
# /merchants, /search, /categories so seeded/demo supply can't show as real.
# Set to "true" at launch — AFTER scrubbing seed data from the production DB.
# (Inlined at build time → flipping it requires a rebuild/redeploy.)
NEXT_PUBLIC_MARKETPLACE_LIVE="false"
