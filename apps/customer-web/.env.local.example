# ─── Redeemo customer website (Next.js) — apps/customer-web/.env.local ───────
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values are inlined at BUILD
# time and are exposed to the browser, so they must NOT be secrets.

# Backend API base URL.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Stripe PUBLISHABLE key (safe for the client). Never the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# SEC-C3 marketplace gate. Default OFF (pre-launch) hides /discover, /map,
# /merchants, /search, /categories so seeded/demo supply can't show as real.
# Set to "true" at launch — AFTER scrubbing seed data from the production DB.
# (Inlined at build time → flipping it requires a rebuild/redeploy.)
NEXT_PUBLIC_MARKETPLACE_LIVE="false"

# ─── SEC-H5 security headers (set in next.config.ts headers()) ───────────────
# The CSP + X-Frame-Options/Referrer-Policy/Permissions-Policy/X-Content-Type
# headers apply automatically; these two flags are NOT NEXT_PUBLIC_ (server-side
# only, read at build time) and tune the rollout:

# CSP escape hatch. Leave UNSET/"false" for an ENFORCING Content-Security-Policy.
# Set to "true" to emit Content-Security-Policy-Report-Only instead (browser
# logs violations but blocks nothing) — use for the first deploy if device-QA
# of the subscribe/register flows surfaces an unexpected blocked origin.
# CSP_REPORT_ONLY="false"

# HSTS staged rollout. Leave UNSET/"false" pre-launch (Vercel already serves
# HTTPS, and *.vercel.app is HSTS-preloaded). Set to "true" ONLY at custom-domain
# cutover, AFTER confirming every subdomain (api/admin/merchant/staging) is
# HTTPS-only. Always emitted with NO includeSubDomains and NO preload (both are
# hard/slow to undo — add them deliberately later).
# ENABLE_HSTS="false"
#
# HSTS max-age in seconds. Default 604800 (1 week) — the staged "verify" value
# so a misconfig expires fast. Once HTTPS is confirmed clean, raise to 63072000
# (2 years). Only takes effect when ENABLE_HSTS="true".
# HSTS_MAX_AGE="604800"
