EXPO_PUBLIC_API_URL=http://localhost:3000

# Plan 4 §AU — local-dev-only UK location override for Discovery QA.
# Set BOTH to bake a fixed lat/lng into a local Metro / Expo dev-client
# build so `useUserLocation` short-circuits the device GPS path. Only
# active when `__DEV__` is true; EAS preview / production builds ignore
# the override entirely. Never set these in production CI. See
# docs/operations/customer-app-dev-location-override.md for full usage
# notes and additional presets.
#
# Huddersfield (Karaara fixture / supply-rich):
# EXPO_PUBLIC_DEV_LOCATION_LAT=53.6458
# EXPO_PUBLIC_DEV_LOCATION_LNG=-1.7850
#
# Brightlingsea (Covelum/Kovalam fixture / supply-thin coastal):
# EXPO_PUBLIC_DEV_LOCATION_LAT=51.8100
# EXPO_PUBLIC_DEV_LOCATION_LNG=1.0200
#
# Central London (dense urban):
# EXPO_PUBLIC_DEV_LOCATION_LAT=51.5081
# EXPO_PUBLIC_DEV_LOCATION_LNG=-0.1281
#
# Aviemore / Cairngorms (rural Highland):
# EXPO_PUBLIC_DEV_LOCATION_LAT=57.1944
# EXPO_PUBLIC_DEV_LOCATION_LNG=-3.8273
