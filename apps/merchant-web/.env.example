# Merchant Portal (merchant-web) environment. Copy to .env.local for local dev.

# Backend API origin. Used by the BFF route handlers (server-side) AND the browser
# direct authed reads (GET /merchant/profile). Must match the API's CORS_ORIGIN for
# the merchant-web origin, and is allowed in the CSP connect-src.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudflare Turnstile site key (registration captcha widget, Slice 4). Dev/test use
# the Cloudflare always-pass TEST key below. Production uses a real site key, and the
# backend CAPTCHA_ENABLED + TURNSTILE_SECRET_KEY are a launch-readiness gate. When the
# backend has CAPTCHA_ENABLED=false (the default), the token is accepted unverified.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
